<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen shown on launch, then switches to Theme.App -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0B14</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0B0B14</item>
        <item name="android:navigationBarColor">#0B0B14</item>
        <item name="android:windowBackground">#0B0B14</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
